{
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"target": "ESNext",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"allowJs": true,
		"module": "preserve",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["vite/client", "bun", "node"],
		"paths": {
			"~/*": ["./src/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "vite.config.ts", "file-routes.d.ts"]
}
