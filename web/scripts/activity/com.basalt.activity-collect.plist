<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Basalt activity collector (ASPTR-227): pi usage scan + calendar fetch
     every 10 minutes. Install (edit the two paths first):
       cp web/scripts/activity/com.basalt.activity-collect.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.basalt.activity-collect.plist
     Logs: ~/.local/share/basalt/collector.log  Uninstall:
       launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.basalt.activity-collect.plist -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.basalt.activity-collect</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/collinpfeifer/.bun/bin/bun</string>
		<!-- EDIT: absolute path to this repo's web dir -->
		<string>/Users/collinpfeifer/orca/workspaces/basalt/main/web/scripts/activity/collect.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/collinpfeifer/.local/share/basalt/collector.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/collinpfeifer/.local/share/basalt/collector.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- mc_ key: create in the dashboard (never commit this file's edits) -->
		<key>ACTIVITY_API_KEY</key>
		<string></string>
		<key>ACTIVITY_BASE_URL</key>
		<string>https://basalt.ac</string>
	</dict>
</dict>
</plist>
