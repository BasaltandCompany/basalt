{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build && bun run scripts/check-client-bundle.ts",
    "postbuild": "bun scripts/prerender.ts",
    "serve": "bun vite preview",
    "lint": "bun lint",
    "start": "bun scripts/bun-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=postgres://dummy@localhost:5/dummy bun test src",
    "prepare": "command -v git >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "db:generate": "drizzle-kit generate && bash scripts/stamp-migrations.sh",
    "db:migrate": "bash scripts/db-guard.sh migrate",
    "db:push": "bash scripts/db-guard.sh push",
    "db:stamp-test": "bash scripts/stamp-migrations.sh --selftest",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aspectrr/feedback-widget": "^0.1.6",
    "@basaltac/ui": "workspace:*",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@kobalte/core": "2.0.0-alpha.4",
    "@lexical/code": "0.45.0",
    "@lexical/headless": "0.45.0",
    "@lexical/history": "0.45.0",
    "@lexical/link": "0.45.0",
    "@lexical/list": "0.45.0",
    "@lexical/markdown": "0.45.0",
    "@lexical/rich-text": "0.45.0",
    "@lexical/selection": "0.45.0",
    "@lexical/table": "0.45.0",
    "@lexical/utils": "0.45.0",
    "@remix-run/cookie": "^1.0.3",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk-solid": "2.0.0-rc.0",
    "diff": "^9.0.0",
    "docx": "^9.16.0",
    "drizzle-orm": "^0.45.4",
    "lexical": "0.45.0",
    "loro-crdt": "^1.18.0",
    "marked": "^18.2.1",
    "modern-screenshot": "^4.7.0",
    "pdfkit": "^0.20.2",
    "plyr": "^3.8.5",
    "resend": "^6.39.0",
    "solid-js": "^2.0.3",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "wreq-js": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.10",
    "filesystem-routing": "0.5.0",
    "jszip": "^3.10.2",
    "postgres": "^4.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
